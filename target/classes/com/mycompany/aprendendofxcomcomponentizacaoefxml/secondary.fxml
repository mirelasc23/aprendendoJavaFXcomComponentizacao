<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import com.mycompany.aprendendofxcomcomponentizacaoefxml.component.CustomInputComponent?>
<?import com.mycompany.aprendendofxcomcomponentizacaoefxml.component.LogoComponent?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.aprendendofxcomcomponentizacaoefxml.SecondaryController">
    <children>
        <Label text="Secondary View" />
        <Button fx:id="secondaryButton" text="Switch to Primary View" onAction="#switchToPrimary" />
        
        <!-- Usando a Logo -->
        <LogoComponent fx:id="logoHeader" />

        <!-- Usando os Inputs Reutilizáveis -->
        <CustomInputComponent fx:id="inputRegraOrigem" />
        <CustomInputComponent fx:id="inputRegraDestino" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
